<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.outcraft</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="abandoned_carts_setting" position="after">
                <setting id="outcraft_setting" string="Send carts to Outcraft"
                         help="I agree to send customer data to Outcraft (outcraft.ai) so its AI agents can call, text and email shoppers who abandon their cart. Requires an Outcraft account.">
                    <field name="outcraft_consent"/>
                    <div class="content-group">
                        <div class="mt8"><b>How to connect</b></div>
                        <ol class="text-muted ps-3 mb-0">
                            <li>In Outcraft, create an abandoned-checkout campaign and choose the <b>Custom API</b> trigger.</li>
                            <li>Copy the URL shown under <b>Send events to this endpoint</b>.</li>
                            <li>Tick the box above, paste the URL below and click <b>Save</b>.</li>
                            <li>Click <b>Send test event</b>. The event appears in Outcraft, and no one is contacted.</li>
                        </ol>
                        <div class="row mt16">
                            <label for="outcraft_trigger_url" string="Trigger URL" class="col-lg-4 o_light_label"/>
                            <field name="outcraft_trigger_url" class="col-lg-8" placeholder="https://app.outcraft.ai/api/v1/trigger/..."/>
                        </div>
                        <div class="row">
                            <label for="outcraft_delay" string="Abandoned after" class="col-lg-4 o_light_label"/>
                            <div class="col-lg-8"><field name="outcraft_delay" class="oe_inline"/> minutes</div>
                        </div>
                        <button name="action_outcraft_test" type="object" string="Send test event"
                                class="btn-link ps-0 mt8" invisible="not outcraft_consent or not outcraft_trigger_url"/>
                        <div class="text-muted mt8">
                            Sends carts with a phone that stay untouched this long, and paid orders so Outcraft
                            stops contacting buyers. Data sent: customer contact details and address, cart items and
                            totals, discount codes and a cart link.
                        </div>
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
